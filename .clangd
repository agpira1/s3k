# clangd configuration for S3K.
#
# The flags themselves come from compile_commands.json, which is generated by
#
#     make compile-commands                        # projects/hello, its default platform
#     ./scripts/gen-compile-commands.sh ping-pong  # some other project
#
# That file is per project, because every project force-includes its own
# s3k_conf.h and the kernel is recompiled against it. Regenerate it when
# switching the project you are working on.

CompileFlags:
  CompilationDatabase: .

  Add:
    # Files with no entry in the database (headers opened on their own, a new
    # project that has not been generated yet) otherwise get parsed as host
    # x86-64 code, and every RISC-V inline asm block turns red.
    - --target=riscv64-unknown-elf

  Remove:
    # Link-time optimisation is a code-generation concern. clangd only parses,
    # and -flto makes it build a full LLVM module for nothing.
    - -flto*
    - -ffat-lto-objects
    # Keep warnings as warnings in the editor. A -Werror build failure is the
    # build system's job to report, not a reason to paint the file red.
    - -Werror
    # GNU-specific and harmless to drop; clang either does not know them or
    # does not need them to parse.
    - -mno-relax
    - -fno-stack-usage
    - -fstack-usage

Diagnostics:
  UnusedIncludes: None
  MissingIncludes: None

InlayHints:
  Enabled: true
  ParameterNames: true
  DeducedTypes: false

Index:
  Background: Build
